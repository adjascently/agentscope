"use client";

import {
  ResponsiveContainer, BarChart, Bar,
  CartesianGrid, XAxis, YAxis, Tooltip
} from "recharts";
import { Activity, CircleAlert, Coins } from "lucide-react";

type Props = {
  activity: { hour: string; runs: number; spans: number }[];
  errors: { category: string; count: number }[];
  tokens: { input_tokens: number; output_tokens: number };
};

const fmt = (n: number) => n.toLocaleString("en-US");

const tooltipStyle = {
  backgroundColor: "#191d27",
  border: "1px solid #343948",
  borderRadius: "8px",
  color: "#e5e7eb",
  fontSize: "12px",
};

export default function Charts({ activity, errors, tokens }: Props) {
  const total = tokens.input_tokens + tokens.output_tokens;
  const inputPct = total ? (tokens.input_tokens / total) * 100 : 0;
  const maxError = Math.max(1, ...errors.map(e => e.count));

  return (
    <div className="grid gap-4 xl:grid-cols-3">
      <div className="rounded-xl border border-[#292e3b] bg-[#151922] p-5 xl:col-span-2">
        <div className="flex items-center justify-between">
          <div>
            <h3 className="text-sm font-semibold text-slate-100">Execution volume</h3>
            <p className="mt-1 text-xs text-slate-400">
              Recorded runs per hour
            </p>
          </div>
          <Activity size={16} className="text-slate-400" />
        </div>

        <div className="mt-6 h-[180px]">
          <ResponsiveContainer width="100%" height="100%">
            <BarChart data={activity}>
              <CartesianGrid stroke="#303643" strokeDasharray="3 5" vertical={false} />
              <XAxis dataKey="hour" tick={{ fill: "#858d9e", fontSize: 10 }} tickLine={false} axisLine={false} />
              <YAxis tick={{ fill: "#858d9e", fontSize: 10 }} tickLine={false} axisLine={false} />
              <Tooltip contentStyle={tooltipStyle} />
              <Bar dataKey="runs" name="Runs" fill="#77869e" radius={[4,4,0,0]} maxBarSize={42} />
            </BarChart>
          </ResponsiveContainer>
        </div>
        <p className="mt-2 text-[11px] text-slate-500">
          Historical recorded hours; gaps without events are not plotted.
        </p>
      </div>

      <div className="rounded-xl border border-[#292e3b] bg-[#151922] p-5">
        <div className="flex items-center justify-between">
          <div>
            <h3 className="text-sm font-semibold text-slate-100">Token usage</h3>
            <p className="mt-1 text-xs text-slate-400">All recorded executions</p>
          </div>
          <Coins size={16} className="text-slate-400" />
        </div>

        <div className="mt-8 text-3xl font-semibold tracking-tight">
          {fmt(total)}
        </div>
        <div className="mt-4 flex h-2 overflow-hidden rounded-full bg-[#303643]">
          <div className="bg-[#8394ad]" style={{ width: `${inputPct}%` }} />
          <div className="bg-[#63a69d]" style={{ width: `${100-inputPct}%` }} />
        </div>
        <div className="mt-5 grid grid-cols-2 gap-3">
          <div>
            <p className="text-xs text-slate-400">Input</p>
            <p className="mt-1 text-base font-medium">{fmt(tokens.input_tokens)}</p>
          </div>
          <div>
            <p className="text-xs text-slate-400">Output</p>
            <p className="mt-1 text-base font-medium">{fmt(tokens.output_tokens)}</p>
          </div>
        </div>
      </div>

      <div className="rounded-xl border border-[#292e3b] bg-[#151922] p-5 xl:col-span-3">
        <div className="mb-5 flex items-center justify-between">
          <div>
            <h3 className="text-sm font-semibold text-slate-100">Top failure categories</h3>
            <p className="mt-1 text-xs text-slate-400">
              Recorded error spans, grouped by category
            </p>
          </div>
          <CircleAlert size={16} className="text-slate-400" />
        </div>

        <div className="grid gap-x-8 gap-y-4 md:grid-cols-2">
          {errors.length === 0 ? (
            <p className="text-sm text-slate-400">No recorded errors.</p>
          ) : errors.slice(0, 6).map(error => (
            <div key={error.category}>
              <div className="mb-2 flex justify-between gap-3 text-xs">
                <span className="text-slate-300">{error.category.replaceAll("_", " ")}</span>
                <span className="font-medium text-slate-200">{error.count}</span>
              </div>
              <div className="h-1.5 rounded-full bg-[#303643]">
                <div
                  className="h-1.5 rounded-full bg-[#c17d82]"
                  style={{ width: `${error.count / maxError * 100}%` }}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}
